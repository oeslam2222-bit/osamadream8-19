# Copy to .env and fill in real values. NEVER commit the filled-in file:
# anything prefixed with VITE_ is compiled into the public JavaScript bundle and
# is readable by anyone who opens the app.

# --- Supabase ---------------------------------------------------------------
# The anon key is a *publishable* key on purpose: it identifies the project, it
# does not authenticate a user. Access control lives in Postgres (RLS) plus the
# server-side checks, so treat it as public and rotate it if it ever leaves
# production by accident.
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-KEY"

# --- Authentication mode ---------------------------------------------------
# server -> Supabase Auth only, no fallback. Client-side password verification
# is DISABLED. The database (RLS + auth.uid()) is the single source of truth.
# legacy / hybrid are intentionally removed for production security.
VITE_AUTH_MODE="server"

# --- Google AI --------------------------------------------------------------
# Only needed if the Gemini integration is ever wired up on a server. A key with
# the VITE_ prefix would be published to every browser, so keep it server-side.
# GEMINI_API_KEY="SERVER-SIDE-ONLY"

# --- Microsoft Power Automate ----------------------------------------------
# Intentionally NOT a VITE_ variable. That trigger URL contains a live "sig="
# token, and anything in the bundle can be copied by any visitor, which would let
# them run your automation. A master admin pastes it once per device from
# Company Settings -> Link Settings; it is stored in that browser only.

# --- App URL ---------------------------------------------------------------
# Used for self-referential links. Safe to expose.
# APP_URL="https://YOUR-APP.example.com"
# --- Cloudinary (صور العملاء/الزيارات) -------------------------------------
# اسم Cloud (يُستخدم لرفع صور عملاء/الزيارات). يُضبط أيضاً من إعدادات النظام.
# VITE_CLOUDINARY_CLOUD_NAME="your-cloud-name"
# VITE_CLOUDINARY_UPLOAD_PRESET="unsigned_preset"

# --- AgentMail (بريد الوكيل الذكي) -----------------------------------------
# Server-side only: these are read by scripts/agentmail-agent.ts and never by
# the Vite bundle, so they must NOT carry the VITE_ prefix.
# API key من https://console.agentmail.to — يُستخدم لإنشاء صندوق الوارد والإرسال.
AGENTMAIL_API_KEY=""
# سر توقيع الـ webhook (يبدأ بـ whsec_) للتأكد أن الطلبات قادمة من AgentMail فعلاً.
AGENTMAIL_WEBHOOK_SECRET=""
# اختياري: ثبّت صندوق وارد معيّن بدل إنشاء واحد تلقائياً.
# AGENTMAIL_INBOX_ID=""
# اختياري: اسم العرض/اسم المستخدم لصندوق الوكيل عند إنشائه أول مرة.
# AGENTMAIL_INBOX_DISPLAY_NAME="Tantawy AI Agent"
# AGENTMAIL_INBOX_USERNAME=""
# اختياري: بورت سيرفر الـ webhook المحلي (الافتراضي 8787).
# AGENTMAIL_WEBHOOK_PORT="8787"
